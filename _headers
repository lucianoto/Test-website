# Cloudflare Pages headers file.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The CSP is deliberately strict: this site has no JavaScript, loads no external
# resources, and sets no cookies. If that ever changes, this file must change too.

/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=3600
